

eqns : [

0 *H_11+ 0*H_12+ 0*H_13+H_14 =  0*(  0*H_41+ 0*H_42+ 0*H_43+H_44 ),
0 *H_21+ 0*H_22+ 0*H_23+H_24 =  0*(  0*H_41+ 0*H_42+ 0*H_43+H_44 ),
0 *H_31+ 0*H_32+ 0*H_33+H_34 =  0*(  0*H_41+ 0*H_42+ 0*H_43+H_44 ),

1 *H_11+ 0*H_12+ 0*H_13+H_14 =  1*(  1*H_41+ 0*H_42+ 0*H_43+H_44 ),
1 *H_21+ 0*H_22+ 0*H_23+H_24 =  0*(  1*H_41+ 0*H_42+ 0*H_43+H_44 ),
1 *H_31+ 0*H_32+ 0*H_33+H_34 =  0*(  1*H_41+ 0*H_42+ 0*H_43+H_44 ),

0 *H_11 + 1*H_12  + 0*H_13  + H_14 =  0*(  0*H_41+ 1*H_42+ 0*H_43+H_44 ),
0 *H_21  + 1*H_22 + 0*H_23  + H_24 =  1*(  0*H_41+ 1*H_42+ 0*H_43+H_44 ),
0 *H_31  + 1*H_32  + 0*H_33 + H_34 =  0*(  0*H_41+ 1*H_42+ 0*H_43+H_44 ),

0 *H_11 + 0*H_12  + 1*H_13  + H_14 =  0*(  0*H_41+ 0*H_42+ 1*H_43+H_44 ),
0 *H_21  + 0*H_22 + 1*H_23  + H_24 =  0*(  0*H_41+ 0*H_42+ 1*H_43+H_44 ),
0 *H_31  + 0*H_32  + 1*H_33 + H_34 =  1*(  0*H_41+ 0*H_42+ 1*H_43+H_44 ),

1*H_11+1*H_12+1*H_13+H_14 = t1*( 1*H_41+1*H_42+1*H_43+H_44 ),
1*H_21+1*H_22+1*H_23+H_24 = t2*( 1*H_41+1*H_42+1*H_43+H_44 ),
1*H_31+1*H_32+1*H_33+H_34 = t3*( 1*H_41+1*H_42+1*H_43+H_44 ) 


/*s1*H_11+s2*H_12+s3*H_13+H_14 = 1*( s1*H_41+s2*H_42+s3*H_43+H_44 ),*/
/*s1*H_21+s2*H_22+s3*H_23+H_24 = 1*( s1*H_41+s2*H_42+s3*H_43+H_44 ),*/
/*s1*H_31+s2*H_32+s3*H_33+H_34 = 1*( s1*H_41+s2*H_42+s3*H_43+H_44 ) */

/*
s_1*H_11+s_2*H_12 +s_3*H_13  +H_14 = t_1*( s1*H_41+s2*H_42+s3*H_43+H_44 ),
s_1*H_21 +s_2*H_22+s_3*H_23  +H_24 = t_2*( s1*H_41+s2*H_42+s3*H_43+H_44 ),
s_1*H_31 +s_2*H_32 +s_3*H_33 +H_34 = t_3*( s1*H_41+s2*H_42+s3*H_43+H_44 )
*/
];

solve( eqns,[
  H_11,H_12,H_13, H_14,
  H_21,H_22,H_23, H_24,
  H_31,H_32,H_33, H_34,
  H_41,H_42,H_43, H_44
] );


H_: matrix(    
              [ H_11,H_12,H_13, H_14 ],
              [ H_21,H_22,H_23, H_24 ],
              [ H_31,H_32,H_33, H_34 ],
              [ H_41,H_42,H_43, H_44 ]
             );

ratsimp( H_ );


S0: matrix( [0], [0], [0], [1] );
Sx: matrix( [1], [0], [0], [1] );
Sy: matrix( [0], [1], [0], [1] );
Sz: matrix( [0], [0], [1], [1] );
Sn: matrix( [1], [1], [1], [1] );


T0: H_ . Sx;
Tx: H_ . Sy;
Ty: H_ . Sz;
Tz: H_ . Sz;
Tn: H_ . Sn;

ratsimp( Tn );