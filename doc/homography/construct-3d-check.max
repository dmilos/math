H_11:(2*t1);
H12:0;
H13:0;
H14:0;
H21:0;
H_22:(2*t2);
H23:0;
H24:0;
H31:0;
H32:0;
H_33:(2*t3);
H34:0;
H41:(-(t3)-t2+t1+1);
H42:-((t3-t2+t1-1));
H43:-((-(t3)+t2+t1-1));
H_44:(t3+t2+t1-1);


H: matrix(
              [ H_11,H12,H13, H14 ],
              [ H21,H_22,H23, H24 ],
              [ H31,H32,H_33, H34 ],
              [ H41,H42,H43, H_44 ]
             );
 

S0: matrix( [0], [0], [0], [1] );
Sx: matrix( [1], [0], [0], [1] );
Sy: matrix( [0], [1], [0], [1] );
Sz: matrix( [0], [0], [1], [1] );
Sn: matrix( [1], [1], [1], [1] );

T0: H . S0;
Tx: H . Sx;
Ty: H . Sy;
Tz: H . Sz;
Tn: H . Sn;

 