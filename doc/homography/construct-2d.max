

eqns : [

0 *H_11+ 0*H_12+ H_13 =  0*(  0*H_31+ 0*H_32 + H_33 ),
0 *H_21+ 0*H_22+ H_23 =  0*(  0*H_31+ 0*H_32 + H_33 ),

1 *H_11+ 0*H_12+ H_13 =  1*(  1*H_31+ 0*H_32 + H_33 ),
1 *H_21+ 0*H_22+ H_23 =  0*(  1*H_31+ 0*H_32 + H_33 ),

0 *H_11+ 1*H_12+ H_13 =  0*(  0*H_31+ 1*H_32 + H_33 ),
0 *H_21+ 1*H_22+ H_23 =  1*(  0*H_31+ 1*H_32 + H_33 ),


S_z_x *H_11+ S_z_y*H_12+ H_13 =  1*( S_z_x*H_31+ S_z_y*H_32 + H_33 ),
S_z_x *H_21+ S_z_y*H_22+ H_23 =  1*( S_z_x*H_31+ S_z_y*H_32 + H_33 )

/*
1 *H_11+ 1*H_12+ H_13 =  T_z_x*( 1*H_31+ 1*H_32 + H_33 ),
1 *H_21+ 1*H_22+ H_23 =  T_z_y*( 1*H_31+ 1*H_32 + H_33 )

 
S_z_x *H_11+ S_z_y*H_12+ H_13 =  T_z_x*( S_z_x*H_31+ S_z_y*H_32 + H_33 ),
S_z_x *H_21+ S_z_y*H_22+ H_23 =  T_z_y*( S_z_x*H_31+ S_z_y*H_32 + H_33 )
*/
 ];

solve( eqns,[
  H_11, H_12, H_13,
  H_21, H_22, H_23,
  H_31, H_32, H_33
 ] );