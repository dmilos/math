f(x, y ) :=
     (1-(+ y ))^2
   + (1-(+x  ))^2
   + (x+y -1)^2;

grad: [diff(f(x, y ), x),diff(f(x, y ), y) ];
solve([grad[1]=0, grad[2]=0 ], [x, y ]);

/* [[x=1/2,y=1/2]]  */
/* [x=2/3,y=2/3] */

eqns : [
  0=1-(+ y )
 ,0=1-(+x  )
 ,0= x+y -1
 ];

solve( eqns,[
  x, y
 ] );

